<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Agente del biométrico: lee la base de ZKAccess 3.5 y empuja las marcaciones
    a Gestivo. Vive en la bandeja del sistema del PC donde corre ZKAccess.

    .NET Framework 4.8 y x86 a propósito, no .NET 8:
      · ZKAccess 3.5 es una aplicación x86 que usa el proveedor Jet 4.0 de 32
        bits (ver su Access.exe.config). Compilando a x86 se ve ese proveedor
        sin trucos; en x64 habría que instalar ACE de 64 bits aparte.
      · 4.8 viene en Windows 10 1903+ y en Windows 11, y para 7/8 hay un
        instalador offline. No hay que instalar ningún runtime nuevo en un PC
        que la empresa no quiere tocar.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x86</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>Gestivo.AgenteBiometrico</RootNamespace>
    <AssemblyName>Gestivo.AgenteBiometrico</AssemblyName>
    <Product>Agente del biométrico · Gestivo</Product>
    <Company>La Carolina</Company>
    <Version>1.1.0</Version>
    <!-- Icono del .exe y de las ventanas. Los de la BANDEJA se dibujan en
         código (Recursos/Glifo.cs) porque cambian de color según el estado;
         este .ico lo genera el mismo dibujo con Recursos/generar-icono.ps1. -->
    <ApplicationIcon>Recursos\agente.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>es</SatelliteResourceLanguages>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyTitle>Agente del biométrico · Gestivo</AssemblyTitle>
    <NeutralLanguage>es-CO</NeutralLanguage>
  </PropertyGroup>

  <!--
    El SDK del lector (zkemkeeper, COM de 32 bits) es opcional EN COMPILACIÓN.

    `Lib\Interop.zkemkeeper.dll` es el interop que ZKTeco genera e instala con
    ZKAccess 3.5 (sale de su carpeta de instalación; ver el README). Con él, el
    agente puede hablar directo con el lector y traer las huellas en tiempo
    real. Sin él, se compila `ClienteZk.SinSdk.cs` en su lugar: todo lo demás
    —incluida la vía Access, que es la que funciona hoy— se puede compilar y
    probar en cualquier PC, y la vía equipo queda deshabilitada diciendo qué
    falta en vez de reventar.

    En EJECUCIÓN el COM sí tiene que estar registrado en 32 bits, cosa que en el
    PC de ZKAccess ya lo está porque es lo que usa ZKAccess.
  -->
  <PropertyGroup>
    <RutaInteropZk>$(MSBuildProjectDirectory)\Lib\Interop.zkemkeeper.dll</RutaInteropZk>
    <HaySdkZk>false</HaySdkZk>
    <HaySdkZk Condition="Exists('$(RutaInteropZk)')">true</HaySdkZk>
  </PropertyGroup>

  <ItemGroup Condition="'$(HaySdkZk)' == 'true'">
    <Reference Include="Interop.zkemkeeper">
      <HintPath>Lib\Interop.zkemkeeper.dll</HintPath>
      <!-- false: se copia como ensamblado normal, no se incrustan los tipos. -->
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>true</Private>
    </Reference>
    <Compile Remove="Dispositivo\ClienteZk.SinSdk.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(HaySdkZk)' != 'true'">
    <Compile Remove="Dispositivo\ClienteZk.Com.cs" />
  </ItemGroup>

  <Target Name="AvisarSinSdkZk" BeforeTargets="Build" Condition="'$(HaySdkZk)' != 'true'">
    <Warning Text="Sin Lib\Interop.zkemkeeper.dll: la lectura directa del lector queda deshabilitada (la vía Access no se ve afectada). Ver el README del agente." />
  </Target>

  <ItemGroup>
    <!-- .NET Framework no trae serializador JSON usable: es la única dependencia. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- En .NET Framework estos ensamblados no vienen referenciados solos:
         System.Security trae DPAPI (ProtectedData) y System.Net.Http el
         HttpClient (que en 4.8 NO está en System.dll). -->
    <Reference Include="System.Security" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Configuration" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" />
    <None Include="publicar.cmd" />
  </ItemGroup>

</Project>
