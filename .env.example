# ── Supabase ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── OpenAI (transcripción de notas de voz de accidentes) ─────────────────────
OPENAI_API_KEY=

# ── MGX (ERP: contable, nómina e inventarios — PostgreSQL, SOLO LECTURA) ──────
# Base ETL que MGX replica a las 2:00 am. El usuario solo tiene SELECT; Gestivo
# nunca escribe allá. Ver docs/mgx-sincronizacion.md.
MGX_DB_HOST=
MGX_DB_PORT=5432
MGX_DB_USER=etl00027
MGX_DB_PASSWORD=
MGX_DB_NAME=etl_00027
# true si el servidor exige SSL («no pg_hba.conf entry … SSL off» es esto).
MGX_DB_SSL=false
# Opcionales (valores por defecto):
# MGX_SYNC_BUDGET_MS=200000        tiempo por paso desde la pantalla (la página tiene 300 s)
# MGX_LOTE_LECTURA=10000           filas por consulta a MGX
# MGX_LOTE_ESCRITURA=2000          filas por llamada a Supabase (además del tope de ~3 MB)
# MGX_STATEMENT_TIMEOUT_MS=120000  tope por consulta en MGX

# ── GEMA (MySQL La Carolina — fuente de datos de rotación, SOLO LECTURA) ─────
GEMA_DB_HOST=carolinainstance.c8twjwe0zioh.us-east-2.rds.amazonaws.com
GEMA_DB_PORT=3306
GEMA_DB_USER=
GEMA_DB_PASSWORD=
GEMA_DB_NAME=gema_cr

# Secreto para proteger el endpoint de cron (Vercel Cron envía Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# ── Data API externa de solo lectura (/api/external/v1) ──────────────────────
# API key estática que el consumidor (p. ej. un consultor de datos con IA) envía
# en el header x-api-key. Genere una clave larga y aleatoria: openssl rand -hex 32
DATA_API_KEY=

# ── Agente del biométrico (ZKAccess → /api/biometrico/*) ────────────────────
# Secreto compartido con la aplicación que corre en el PC del biométrico
# (ops/agente-biometrico). Va en el header Authorization: Bearer <secreto>.
# A diferencia de CRON_SECRET, este se exige SIEMPRE: sin él los endpoints
# responden 503 y no entra ninguna marcación (son de escritura).
# Genere uno con: openssl rand -hex 32
BIOMETRICO_SECRET=

# ── Meta Ads (módulo Campañas — embudo de reclutamiento) ─────────────────────
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_API_VERSION=v21.0

# ── Portal de afiliados (/portal-afiliados) ──────────────────────────────────
# Secreto con que el servidor firma la sesión de los afiliados (no es de
# Supabase). 32 caracteres o más. Opcional: si falta, se usa el que genera la
# base en afiliado_portal_config (migración 20260925222043).
# Genere uno con: openssl rand -base64 48 · Cambiarlo cierra todas las sesiones.
AFILIADOS_SESSION_SECRET=
